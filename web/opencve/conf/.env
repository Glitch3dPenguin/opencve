# OpenCVE webserver env — klabsinfra fork (committed defaults; edit before first start)
#
# If you change POSTGRES_PASSWORD in docker/.env, mirror the credentials below.
# OPENCVE_SECRET_KEY is generated on first boot by the opencve-init container —
# leave it empty.

# PostgreSQL Database URL
OPENCVE_DATABASE_URL=postgresql://opencve:opencve@postgres:5432/opencve

# Django secret key (generated automatically on first boot)
OPENCVE_SECRET_KEY=

# OpenCVE repositories paths (defaults are correct for the deployed volumes)
OPENCVE_KB_REPO_PATH=/app/repositories/opencve-kb
OPENCVE_MITRE_REPO_PATH=/app/repositories/cvelistV5
OPENCVE_NVD_REPO_PATH=/app/repositories/opencve-nvd
OPENCVE_REDHAT_REPO_PATH=/app/repositories/opencve-redhat
OPENCVE_VULNRICHMENT_REPO_PATH=/app/repositories/vulnrichment

# PostgreSQL DB URL of OpenCVE v1 (only used for a v1 -> v2 migration; leave as-is)
OPENCVE_V1_DATABASE=postgresql://opencve:opencve@postgres:5432/opencve_v1

# Base URL (used in notification emails and links) — CHANGE to your domain
OPENCVE_WEB_BASE_URL=https://opencve.klabsdev.com

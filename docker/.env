# OpenCVE docker-compose vars — klabsinfra fork (committed defaults; edit before first start)
#
# === CHANGE THESE BEFORE FIRST START ===
# POSTGRES_PASSWORD:            change, and mirror it into web/opencve/conf/.env (OPENCVE_DATABASE_URL)
# _AIRFLOW_WWW_USER_PASSWORD:   Airflow ops UI password (default = the username, airflow/airflow)
# DJANGO_SUPERUSER_PASSWORD:    your OpenCVE admin account password (created on first boot)
# TRAEFIK_RULE:                 your domain
COMPOSE_PROJECT_NAME=opencve
OPENCVE_REPOSITORY=https://github.com/Glitch3dPenguin/opencve.git
# Image tag to run (matches the tags publish-images.yaml pushes). Bump + redeploy to upgrade.
OPENCVE_VERSION=v3.1.0
# Image registry (GHCR package of this fork, built by .github/workflows/publish-images.yaml)
OPENCVE_REGISTRY=ghcr.io/glitch3dpenguin/opencve

POSTGRES_USER=opencve
POSTGRES_PASSWORD=opencve
POSTGRES_VERSION=15

# Web app admin account (created by the opencve-init one-shot on first boot)
DJANGO_SUPERUSER_USERNAME=opencve-admin
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_STRONG
DJANGO_SUPERUSER_EMAIL=admin@klabsdev.com

# Traefik routing (labels on the nginx service)
TRAEFIK_RULE=Host(`opencve.klabsdev.com`)
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERTRESOLVER=cloudflare

# Airflow ops UI bind address (127.0.0.1 = SSH-tunnel-only; set to the WireGuard
# interface address to expose it on that plane)
AIRFLOW_BIND_ADDR=127.0.0.1

OPENCVE_PORT=80
GUNICORN_CMD_ARGS="--workers 2 --access-logfile '-'"

# Airflow docker-compose vars
AIRFLOW_WEBSERVER_PORT=8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Airflow configuration vars
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/opencve
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/opencve
AIRFLOW__CELERY__BROKER_URL=redis://:@redis/1
# Same public default as upstream's example — generate your own per deployment
# (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW__CORE__FERNET_KEY='ywvTuNQw6bW-UlEyS0ykTqiz9on1cyMlHT7e1Ddo060='
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION='true'
AIRFLOW__CORE__LOAD_EXAMPLES='false'
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO
AIRFLOW__API__AUTH_BACKENDS='airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session'
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK='true'

# SQLALCHEMY
SQLALCHEMY_SILENCE_UBER_WARNING=1
